# Copy this file to .env for local development. Replace every value before deployment.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeBeforeProduction123!
CORS_ORIGINS=https://tienda-videojuegos.duckdns.org,http://localhost:4200
APP_DOMAIN=tienda-videojuegos.duckdns.org
OPENOBSERVE_DOMAIN=obs-videojuegos.duckdns.org
ZO_ROOT_USER_EMAIL=observe@example.com
ZO_ROOT_USER_PASSWORD=ChangeThisOpenObservePassword123!
OO_BASIC_AUTH=b2JzZXJ2ZUBleGFtcGxlLmNvbTpDaGFuZ2VUaGlzT3Blbk9ic2VydmVQYXNzd29yZDEyMyE=

# Optional SMTP for OpenObserve email alerts (Gmail example).
# Put the app password only in the EC2 .env file, never in Git.
ZO_SMTP_ENABLED=false
ZO_SMTP_HOST=smtp.gmail.com
ZO_SMTP_PORT=587
ZO_SMTP_USER_NAME=
ZO_SMTP_PASSWORD=
ZO_SMTP_FROM_EMAIL=
ZO_SMTP_ENCRYPTION=starttls
